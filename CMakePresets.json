{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "Use the VS2022 generator; no need to source vcvars",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "AGENT_CORE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2022-ue",
      "displayName": "Visual Studio 2022 + MSVC 14.38 (UE 5.6 toolchain)",
      "description": "Pin the MSVC toolset used by Unreal Engine 5.6 so static libraries are CRT/toolchain compatible.",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/vs2022-ue",
      "toolset": "v143,version=14.38.33130",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.22621.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "debug-ue",
      "configurePreset": "vs2022-ue",
      "configuration": "Debug"
    },
    {
      "name": "release-ue",
      "configurePreset": "vs2022-ue",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-ue",
      "configurePreset": "vs2022-ue",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-ue",
      "configurePreset": "vs2022-ue",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
