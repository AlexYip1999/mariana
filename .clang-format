---
Language: Cpp
BasedOnStyle: Microsoft
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
# Allman：所有大括号独占一行，右大括号 } 必须在行首
# 空函数体例外：{} 保持紧凑；带初始化列表的构造函数把 {} 放在初始化列表下一行
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Always
  AfterCaseLabel: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
# 空函数允许写成 {} 单行：virtual void OnTurnStart() {}
AllowShortFunctionsOnASingleLine: Empty
# 构造函数初始化列表必须换行，逗号放在行首
PackConstructorInitializers: Never
BreakConstructorInitializers: BeforeComma
# 函数/方法定义之间必须空一行（包括空实现的 override）
SeparateDefinitionBlocks: Always
# switch：case/default 标签相对 switch 缩进一级；块位置由 AfterCaseLabel 控制
IndentCaseLabels: true
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: None
NamespaceIndentation: None
PointerAlignment: Left
ReferenceAlignment: Left
SortIncludes: CaseInsensitive
IncludeBlocks: Preserve
